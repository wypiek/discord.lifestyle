{
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Built by `vite build`
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-counter",
      "database_id": "PASTE-DATABASE-ID-HERE"
    }
  ],
  // Per worker location, keyed by IP (reads) or human-check session (clicks).
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "CLICK_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 10 } }
  ],
  "vars": {
    // "auto" watches D1 usage, "on" forces the maintenance page, "off" never shows it.
    "MAINTENANCE": "auto",
    "CF_ACCOUNT_ID": "PASTE-ACCOUNT-ID-HERE",
    // Workers Free plan limits; raise these on a paid plan.
    "DB_DAILY_READ_LIMIT": "5000000",
    "DB_DAILY_WRITE_LIMIT": "100000"
  }
  // Secrets (wrangler secret put NAME): TURNSTILE_SECRET, SESSION_SECRET, CF_API_TOKEN
}
