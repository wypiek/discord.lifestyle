{
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Built by `vite build`
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-counter",
      "database_id": "PASTE-DATABASE-ID-HERE"
    }
  ]
}
